[Unit]
Description=Back up Zsh command history
ConditionPathExists=%h/.zsh_history

[Service]
Type=oneshot
ExecStart=%h/.local/bin/zsh-history-backup backup
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=zsh-history-backup
StateDirectoryMode=0700
